{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Mesteriis/tg-account-mcp",
  "title": "TG multi-account MCP",
  "description": "Self-hosted, consent-based access to Telegram accounts and bots for MCP clients",
  "version": "0.5.2",
  "websiteUrl": "https://github.com/Mesteriis/tg-account-mcp",
  "repository": {
    "url": "https://github.com/Mesteriis/tg-account-mcp",
    "source": "github",
    "id": "1373356470"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "tg-account-mcp",
      "version": "0.5.2",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "TG_MCP_STATE_DIR",
          "description": "Private directory initialized with tg-mcp setup",
          "format": "filepath",
          "isRequired": false
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8000/mcp",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {mcp_token}",
            "variables": {
              "mcp_token": {
                "description": "Token returned by tg-mcp show-token",
                "format": "string",
                "isRequired": true,
                "isSecret": true
              }
            }
          }
        ]
      }
    }
  ]
}
