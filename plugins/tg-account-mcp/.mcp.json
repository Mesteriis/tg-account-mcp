{
  "mcpServers": {
    "tg-account": {
      "command": "uvx",
      "args": [
        "--from",
        "tg-account-mcp==0.5.1",
        "tg-mcp",
        "bridge"
      ],
      "env_vars": [
        "TG_MCP_TOKEN",
        "TG_MCP_URL",
        "TG_MCP_DISCOVERY_PORT",
        "TG_MCP_STATE_DIR"
      ],
      "startup_timeout_sec": 45,
      "tool_timeout_sec": 180
    }
  }
}
